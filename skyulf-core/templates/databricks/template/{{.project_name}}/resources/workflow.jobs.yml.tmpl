resources:
  jobs:
    train:
      name: ${bundle.name}_train
      max_concurrent_runs: 1
      queue:
        enabled: true
      parameters:
        - name: lifecycle_action
          default: {{if eq .retraining_mode "scheduled"}}train_monthly{{else}}train{{end}}
        - name: candidate_version
          default: ""
        - name: expected_champion_version
          default: ""
        - name: rejection_reason
          default: ""
        - name: promotion_receipt_json
          default: ""
{{if eq .retraining_mode "scheduled"}}
      schedule:
        quartz_cron_expression: ${var.retraining_cron_expression}
        timezone_id: ${var.retraining_timezone_id}
        pause_status: ${var.retraining_pause_status}
{{end}}
      tasks:
        - &lifecycle_task
          task_key: prepare_request
          max_retries: 0
          notebook_task:
            notebook_path: ../src/workflow.py
            base_parameters: &lifecycle_parameters
              workflow_contract: "2"
              job_id: '{{"{{job.id}}"}}'
              job_run_id: '{{"{{job.run_id}}"}}'
              repair_count: '{{"{{job.repair_count}}"}}'
              execution_count: '{{"{{task.execution_count}}"}}'
              deployed_score_handoff: "{{.score_handoff}}"
              lifecycle_action: '{{"{{job.parameters.lifecycle_action}}"}}'
              candidate_version: '{{"{{job.parameters.candidate_version}}"}}'
              expected_champion_version: '{{"{{job.parameters.expected_champion_version}}"}}'
              rejection_reason: '{{"{{job.parameters.rejection_reason}}"}}'
              promotion_receipt_json: '{{"{{job.parameters.promotion_receipt_json}}"}}'
              config_path: ${workspace.file_path}/config/workflow.json
              experiment_name: ${workspace.root_path}/experiment
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ${workspace.file_path}/dist/skyulf_core-0.9.0-py3-none-any.whl
            - pypi:
                package: mlflow==3.16.1
{{end}}
        - task_key: training_requested
          depends_on:
            - task_key: prepare_request
          max_retries: 0
          condition_task:
            op: EQUAL_TO
            left: '{{"{{tasks.prepare_request.values.training_requested}}"}}'
            right: "true"
        - <<: *lifecycle_task
          task_key: train_candidate
          depends_on:
            - task_key: training_requested
              outcome: "true"
          notebook_task:
            notebook_path: ../src/train_candidate.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.prepare_request.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - <<: *lifecycle_task
          task_key: evaluate_and_register
          depends_on:
            - task_key: train_candidate
          notebook_task:
            notebook_path: ../src/evaluate_candidate.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.train_candidate.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - <<: *lifecycle_task
          task_key: compare_candidate
          depends_on:
            - task_key: evaluate_and_register
          notebook_task:
            notebook_path: ../src/compare_candidate.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.evaluate_and_register.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - <<: *lifecycle_task
          task_key: apply_promotion_policy
          depends_on:
            - task_key: compare_candidate
          notebook_task:
            notebook_path: ../src/apply_promotion_policy.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.compare_candidate.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - <<: *lifecycle_task
          task_key: apply_operator_action
          depends_on:
            - task_key: training_requested
              outcome: "false"
          notebook_task:
            notebook_path: ../src/apply_operator_action.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.prepare_request.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - <<: *lifecycle_task
          task_key: finalize_training
          run_if: ALL_DONE
          depends_on:
            - task_key: train_candidate
            - task_key: evaluate_and_register
            - task_key: compare_candidate
            - task_key: apply_promotion_policy
          notebook_task:
            notebook_path: ../src/finalize_training.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.prepare_request.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - <<: *lifecycle_task
          task_key: publish_result
          depends_on:
            - task_key: apply_promotion_policy
            - task_key: apply_operator_action
            - task_key: finalize_training
          notebook_task:
            notebook_path: ../src/publish_result.py
            base_parameters:
              <<: *lifecycle_parameters
              reference_json: '{{"{{tasks.prepare_request.values.reference_json}}"}}'
              tracking_uri: '{{"{{tasks.prepare_request.values.tracking_uri}}"}}'
        - task_key: scoring_requested
          depends_on:
            - task_key: publish_result
          max_retries: 0
          condition_task:
            op: EQUAL_TO
            left: '{{"{{tasks.publish_result.values.score_requested}}"}}'
            right: "true"
        - task_key: run_batch_scoring
          max_retries: 0
          depends_on:
            - task_key: scoring_requested
              outcome: "true"
          run_job_task:
            job_id: ${resources.jobs.score.id}
            job_parameters:
              score_model_version: ""
{{if eq .compute_mode "serverless"}}
      environments:
        - environment_key: skyulf
          spec:
            client: "4"
            dependencies:
              - ${workspace.file_path}/dist/skyulf_core-0.9.0-py3-none-any.whl
              - mlflow==3.16.1
{{else}}
      job_clusters:
        - job_cluster_key: skyulf
          new_cluster:
            spark_version: {{.spark_version}}
            node_type_id: {{.node_type_id}}
            policy_id: ${var.cluster_policy_id}
            custom_tags:
              {{.cost_tag_key}}: ${var.cost_tag_value}
            autoscale:
              min_workers: 2
              max_workers: 4
{{end}}
    score:
      name: ${bundle.name}_score
      max_concurrent_runs: 1
      queue:
        enabled: true
      parameters:
        - name: score_model_version
          default: ""
{{if eq .scoring_mode "scheduled"}}
      schedule:
        quartz_cron_expression: ${var.scoring_cron_expression}
        timezone_id: ${var.scoring_timezone_id}
        pause_status: ${var.scoring_pause_status}
{{end}}
      tasks:
        - task_key: score
          max_retries: 0
          notebook_task:
            notebook_path: ../src/score.py
            base_parameters:
              workflow_contract: "2"
              deployed_score_handoff: "{{.score_handoff}}"
              score_model_version: '{{"{{job.parameters.score_model_version}}"}}'
              config_path: ${workspace.file_path}/config/workflow.json
              catalog: ${var.catalog}
              input_schema: ${var.input_schema}
              output_schema: ${var.output_schema}
              metadata_schema: ${var.metadata_schema}
              resource_suffix: ${var.resource_suffix}
{{if eq .compute_mode "serverless"}}
          environment_key: skyulf
          disable_auto_optimization: true
{{else}}
          job_cluster_key: skyulf
          libraries:
            - whl: ${workspace.file_path}/dist/skyulf_core-0.9.0-py3-none-any.whl
            - pypi:
                package: mlflow==3.16.1
{{end}}
{{if eq .compute_mode "serverless"}}
      environments:
        - environment_key: skyulf
          spec:
            client: "4"
            dependencies:
              - ${workspace.file_path}/dist/skyulf_core-0.9.0-py3-none-any.whl
              - mlflow==3.16.1
{{else}}
      job_clusters:
        - job_cluster_key: skyulf
          new_cluster:
            spark_version: {{.spark_version}}
            node_type_id: {{.node_type_id}}
            policy_id: ${var.cluster_policy_id}
            custom_tags:
              {{.cost_tag_key}}: ${var.cost_tag_value}
            autoscale:
              min_workers: 2
              max_workers: 4
{{end}}

"""Editable model and tuning settings for single-model training.

Bundle fills MODELING from your selections. Change model parameters, tuning
strategy or search_space here; the loader binds this to pipeline.modeling.
Keep config/workflow.json's pipeline.modeling empty to avoid two definitions.
An ensemble is one model: its members/settings live in base_model.params.
Set search_space to {} to rebuild automatic ranges from the installed Core.
After changing ensemble members or calibration, update nested search keys or
clear the space. Fixed model parameters must not contradict searched axes.

model_competition.py describes competitors for one target. multi_model.py
describes independent targets; model_set.py governs their joint publication.
Those layouts do not use this file. Scoring replays the saved fitted artifact.
"""

from copy import deepcopy


MODELING = {{if eq .training_layout "single_model"}}{{template "modeling" (map (pair "values" .) (pair "prefix" "") (pair "model" (index . (printf "%s_model" .task))) (pair "task" .task) (pair "ensemble_prefix" "single_ensemble_"))}}{{else}}{}{{end}}


def build_modeling():
    """Return independent settings for the next training run or offline preview."""
    return deepcopy(MODELING)
